name = "cafe-brief-preview"
main = "worker/index.mjs"
compatibility_date = "2026-11-05"

[assets]
directory = "./docs"
binding = "ASSETS"
run_worker_first = ["/api/*"]

[[d1_databases]]
binding = "DB"
database_name = "cafe-brief"
database_id = "REPLACE_WITH_D1_DATABASE_ID"

[vars]
ARK_MODEL = "your-text-model-endpoint-id"
ARK_IMAGE_MODEL = "doubao-seedream-5-0-pro-260628"
MAX_PUBLIC_DAILY_CALLS = "100"

[triggers]
crons = ["0 3 * * *"]
